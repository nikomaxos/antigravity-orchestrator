[Unit]
Description=Antigravity Universal Multi-Workspace Gatekeeper Enforcement Daemon
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/home/nick/.local/share/mise/installs/node/26.8.2/bin/node /usr/local/lib/agy-gatekeeper/server.js
Restart=always
RestartSec=2
Environment=NODE_ENV=production
Environment=PATH=/home/nick/.local/share/mise/shims:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

[Install]
WantedBy=multi-user.target
