{
  "commit-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agy-hook.js commit-gate",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "protect-enforcement": {
    "PreToolUse": [
      {
        "matcher": "write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agy-hook.js protect-enforcement",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agy-hook.js protect-enforcement",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agy-hook.js protect-enforcement",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agy-hook.js protect-enforcement",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/agy-hook.js protect-enforcement",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "qa-stop-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/agy-hook.js qa-stop-gate",
        "timeout": 10
      }
    ]
  },
  "preflight-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node scripts/agy-hook.js preflight",
        "timeout": 5
      }
    ]
  }
}
