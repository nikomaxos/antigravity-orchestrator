  "gemini_quota_guard": {
    "_comment": "AUTOMATIC Gemini reserve trigger (workspace .agents/scripts/gemini-budget.js, run by preflight on every PreInvocation). Self-meters PLANNER_RESPONSE tokens (input + output + cache_read*cache_read_weight) from ~/.gemini/antigravity/brain/*/transcript.jsonl over a rolling 5h window and a rolling 7d window. five_hour_token_budget calibrated 2026-11-18 from the real 5h-limit exhaustion: 238.8M observed in 05:29:30Z-10:29:30Z (1002 steps) x 0.95 safety. Optional machine-local threshold overrides (strictly allowlisted: ctx_hard_limit_tokens, ctx_warn_tokens, reinject_minutes, warn_threshold_pct) live in ~/.gemini/config/model-routing.local.json (never touched by agy-arch-sync). Manual gemini-quota-mode.sh --set-reserve (source=manual) is never overridden.",
    "enabled": true,
    "auto": true,
    "window_hours": 5,
    "five_hour_token_budget": 226800000,
    "weekly_token_budget": null,
    "reserve_threshold_pct": 10,
    "restore_threshold_pct": 25,
    "warn_threshold_pct": 30,
    "ctx_hard_limit_tokens": 200000,
    "ctx_warn_tokens": 150000,
    "cache_read_weight": 1.0,
    "reinject_minutes": 15,
    "exclude_model_regex": "claude|opus|sonnet|haiku|gpt|codex|deepseek"
  }
