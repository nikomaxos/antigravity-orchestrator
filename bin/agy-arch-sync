#!/usr/bin/env bash
# =============================================================================
# Antigravity Architecture Synchronizer (`agy-arch-sync`)
# =============================================================================
# Synchronizes the multi-model orchestrator matrix, dynamic routing rules,
# global skills, and registered workspace scripts across machines.
#
# Usage:
#   agy-arch-sync [--quiet] [--workspace <path>]
# =============================================================================
set -euo pipefail

QUIET=0
REGISTER_WS=""
while [ $# -gt 0 ]; do
  case "$1" in
    -q|--quiet|quiet)
      QUIET=1
      shift
      ;;
    -w|--workspace)
      REGISTER_WS="${2:-}"
      shift 2
      ;;
    -w=*|--workspace=*)
      REGISTER_WS="${1#*=}"
      shift
      ;;
    *)
      if [ -d "$1" ]; then
        REGISTER_WS="$1"
      fi
      shift
      ;;
  esac
done

log() {
  if [ "$QUIET" -eq 0 ]; then
    echo "$@"
  fi
}

USER_HOME="${HOME:-$(getent passwd "$(id -un)" 2>/dev/null | cut -d: -f6 || echo "/home/nick")}"
CONFIG_DIR="${USER_HOME}/.gemini/config"
REPO_DIR="${USER_HOME}/Development/antigravity-orchestrator"
[ ! -d "$REPO_DIR" ] && REPO_DIR="${USER_HOME}/.local/share/antigravity-orchestrator"
STAMP_FILE="${CONFIG_DIR}/.last-orchestrator-sync"
WS_REGISTRY="${CONFIG_DIR}/orchestrator-workspaces.json"

mkdir -p "$CONFIG_DIR"

if [ ! -d "$REPO_DIR" ]; then
  log "❌ Repository not found at: ${REPO_DIR}"
  exit 1
fi

log "🔄 Checking for updates in ${REPO_DIR}..."

if git -C "$REPO_DIR" remote get-url origin >/dev/null 2>&1; then
  # Try git pull --ff-only
  if ! git -C "$REPO_DIR" pull --ff-only 2>/dev/null; then
    # Try fetching and fast-forwarding origin/main
    git -C "$REPO_DIR" fetch origin main 2>/dev/null || true
    git -C "$REPO_DIR" merge --ff-only origin/main 2>/dev/null || {
      log "⚠️ Git pull failed or fast-forward not possible. Keeping local working tree."
    }
  fi
else
  log "ℹ️  No remote 'origin' configured for ${REPO_DIR}. Skipping pull."
fi

# 0. Register workspace if requested
if [ -n "$REGISTER_WS" ] && [ -d "$REGISTER_WS" ]; then
  CANONICAL_WS=$(cd "$REGISTER_WS" && pwd)
  if [ -d "${CANONICAL_WS}/.agents" ] || [ -d "${CANONICAL_WS}/.git" ]; then
    if [ -f "$WS_REGISTRY" ] && command -v jq >/dev/null 2>&1; then
      if ! jq -e --arg ws "$CANONICAL_WS" 'index($ws)' "$WS_REGISTRY" >/dev/null 2>&1; then
        jq --arg ws "$CANONICAL_WS" '. += [$ws] | unique' "$WS_REGISTRY" > "${WS_REGISTRY}.tmp" && mv -f "${WS_REGISTRY}.tmp" "$WS_REGISTRY"
        log "   -> Registered workspace: ${CANONICAL_WS}"
      fi
    else
      echo "[\"${CANONICAL_WS}\"]" > "$WS_REGISTRY"
      log "   -> Initialized registry with workspace: ${CANONICAL_WS}"
    fi
  fi
fi

# 1. Sync global rules & routing
log "📦 Syncing global configs & skills into ${CONFIG_DIR}..."
if [ -f "${REPO_DIR}/global/gemini/config/model-routing.json" ]; then
  cp -f "${REPO_DIR}/global/gemini/config/model-routing.json" "${CONFIG_DIR}/model-routing.json"
fi
if [ -f "${REPO_DIR}/global/gemini/config/AGENTS.md" ]; then
  cp -f "${REPO_DIR}/global/gemini/config/AGENTS.md" "${CONFIG_DIR}/AGENTS.md"
fi
if [ -f "${REPO_DIR}/global/gemini/config/GEMINI.md" ]; then
  cp -f "${REPO_DIR}/global/gemini/config/GEMINI.md" "${CONFIG_DIR}/GEMINI.md"
  cp -f "${REPO_DIR}/global/gemini/config/GEMINI.md" "${USER_HOME}/.gemini/GEMINI.md" 2>/dev/null || true
fi

# Sync global skills dynamically
mkdir -p "${CONFIG_DIR}/skills"
for skill_dir in "${REPO_DIR}/global/gemini/config/skills"/*; do
  if [ -d "$skill_dir" ]; then
    skill=$(basename "$skill_dir")
    mkdir -p "${CONFIG_DIR}/skills/${skill}"
    cp -r "${skill_dir}/"* "${CONFIG_DIR}/skills/${skill}/" 2>/dev/null || true
    chmod +x "${CONFIG_DIR}/skills/${skill}"/scripts/*.sh 2>/dev/null || true
  fi
done

# Sync global workflows (both workflows and legacy global_workflows)
if [ -d "${REPO_DIR}/global/gemini/config/workflows" ]; then
  mkdir -p "${CONFIG_DIR}/workflows" "${CONFIG_DIR}/global_workflows"
  cp -r "${REPO_DIR}/global/gemini/config/workflows/"* "${CONFIG_DIR}/workflows/" 2>/dev/null || true
  cp -r "${REPO_DIR}/global/gemini/config/workflows/"* "${CONFIG_DIR}/global_workflows/" 2>/dev/null || true
fi

# 2. Sync registered workspaces
SYNC_SCRIPTS=(
  "codex-lib.sh"
  "frontier-orchestrate.sh"
  "codex-orchestrate.sh"
  "claude-orchestrate.sh"
  "opencode-orchestrate.sh"
  "codex-rca.sh"
  "gemini-quota-mode.sh"
)

if [ -f "$WS_REGISTRY" ] && command -v jq >/dev/null 2>&1; then
  log "🔄 Syncing registered workspaces from ${WS_REGISTRY}..."
  WORKSPACES=$(jq -r '.[] // empty' "$WS_REGISTRY" 2>/dev/null || true)
  while IFS= read -r ws; do
    [ -z "$ws" ] && continue
    if [ -d "$ws" ] && [ -d "${ws}/.agents" ]; then
      log "   -> Syncing workspace: ${ws}"
      mkdir -p "${ws}/.agents/config" "${ws}/.agents/scripts"

      # Sync model-routing.json
      if [ -f "${CONFIG_DIR}/model-routing.json" ]; then
        cp -f "${CONFIG_DIR}/model-routing.json" "${ws}/.agents/config/model-routing.json"
      fi

      # Sync scripts
      for s in "${SYNC_SCRIPTS[@]}"; do
        src="${REPO_DIR}/workspace-template/.agents/scripts/${s}"
        if [ -f "$src" ]; then
          cp -f "$src" "${ws}/.agents/scripts/${s}"
          chmod +x "${ws}/.agents/scripts/${s}" 2>/dev/null || true
        fi
      done

      # Sync workspace skills if available
      if [ -d "${REPO_DIR}/workspace-template/.agents/skills" ]; then
        mkdir -p "${ws}/.agents/skills"
        for wsk in "${REPO_DIR}/workspace-template/.agents/skills"/*; do
          if [ -d "$wsk" ]; then
            sk_name=$(basename "$wsk")
            mkdir -p "${ws}/.agents/skills/${sk_name}"
            cp -r "${wsk}/"* "${ws}/.agents/skills/${sk_name}/" 2>/dev/null || true
          fi
        done
      fi

      # Sync workspace workflows if available
      if [ -d "${REPO_DIR}/workspace-template/.agents/workflows" ]; then
        mkdir -p "${ws}/.agents/workflows"
        cp -r "${REPO_DIR}/workspace-template/.agents/workflows/"* "${ws}/.agents/workflows/" 2>/dev/null || true
      fi
    fi
  done <<< "$WORKSPACES"
fi

# 3. Stamp last sync time
date +%s > "$STAMP_FILE"
log "✅ Architecture sync complete! Stamped ${STAMP_FILE}"
